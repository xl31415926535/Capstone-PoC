                  "maximum": 4
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "text"
              ]
            },
            "minItems": 4,
            "maxItems": 4
          },
          "answer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "optionId": {
                "type": "integer",
