              "material_inference",
              "circuit_prediction",
              "fault_diagnosis",
              "test_design",
              "claim_evaluation"
            ]
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "Easy",
              "Medium",
              "Hard"
            ]
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
